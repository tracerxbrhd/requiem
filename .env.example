# Host-native development. Compose overrides this URL with its postgres service hostname.
REQUIEM_DATABASE_URL=postgresql+psycopg://requiem:requiem@127.0.0.1:5432/requiem
# Required only for requiem-bot; keep real credentials in .env.
REQUIEM_DISCORD_TOKEN=
REQUIEM_MESSAGE_CONTENT_INTENT_ENABLED=false
REQUIEM_GUILD_MEMBERS_INTENT_ENABLED=false
# Optional until external integrations need these identifiers.
REQUIEM_DISCORD_APPLICATION_ID=
REQUIEM_DISCORD_CLIENT_ID=
REQUIEM_API_HOST=127.0.0.1
REQUIEM_API_PORT=8000
REQUIEM_ENVIRONMENT=development
REQUIEM_LOG_LEVEL=INFO
REQUIEM_LOG_FORMAT=console
